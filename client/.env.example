VITE_API_URL=http://localhost:3000/api

# Geoapify API key, used only for address autocomplete on Add/Edit
# Location. The /map page's tiles come from OpenStreetMap directly and
# need no API key at all. Free to create at
# https://myprojects.geoapify.com - see the root README's map setup
# section. Never commit a real key - this is a placeholder only.
VITE_GEOAPIFY_API_KEY=your_geoapify_api_key_here
