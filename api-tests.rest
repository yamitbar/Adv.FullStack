### Pathly API - REST Client scratch file
### Replace the variables below with real values captured while testing
### locally. Never commit real tokens, ids, or personal file paths here -
### this file is tracked by git.

@baseUrl = http://localhost:3000/api
@token = REPLACE_WITH_A_LOGIN_TOKEN
@otherToken = REPLACE_WITH_A_SECOND_USER_LOGIN_TOKEN
@tripId = REPLACE_WITH_TRIP_ID
@locationId = REPLACE_WITH_LOCATION_ID
@memoryId = REPLACE_WITH_MEMORY_ID
@inviteCode = REPLACE_WITH_INVITE_CODE
@userId = REPLACE_WITH_USER_ID

############ AUTH ############

### Register
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "name": "Test User",
  "email": "testuser@example.com",
  "password": "REPLACE_WITH_A_TEST_PASSWORD"
}

### Login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "testuser@example.com",
  "password": "REPLACE_WITH_A_TEST_PASSWORD"
}

### Login wrong password
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "testuser@example.com",
  "password": "wrongpassword"
}

### Get current user
GET {{baseUrl}}/auth/me
Authorization: Bearer {{token}}

############ USERS ############

### Get all users (admin only)
GET {{baseUrl}}/users
Authorization: Bearer {{token}}

### Get trips without a token (expect 401)
GET {{baseUrl}}/trips

############ TRIPS ############

### Create trip
POST {{baseUrl}}/trips
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "USA Family Trip",
  "description": "Summer vacation with the family",
  "destination": "United States",
  "startDate": "2026-08-01",
  "endDate": "2026-08-20",
  "coverImage": ""
}

### Get trips
GET {{baseUrl}}/trips
Authorization: Bearer {{token}}

### Get trip by id
GET {{baseUrl}}/trips/{{tripId}}
Authorization: Bearer {{token}}

### Update trip
PUT {{baseUrl}}/trips/{{tripId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "Updated Trip Title"
}

### Join trip with invite code
POST {{baseUrl}}/trips/join
Authorization: Bearer {{otherToken}}
Content-Type: application/json

{
  "inviteCode": "{{inviteCode}}"
}

### Delete trip
DELETE {{baseUrl}}/trips/{{tripId}}
Authorization: Bearer {{token}}

############ LOCATIONS ############

### Create location (no coordinates required)
POST {{baseUrl}}/trips/{{tripId}}/locations
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "Sunset View",
  "placeName": "Grand Canyon National Park",
  "address": "Arizona, USA",
  "coverImage": "",
  "visitedAt": "2026-08-08"
}

### Get locations for a trip
GET {{baseUrl}}/trips/{{tripId}}/locations
Authorization: Bearer {{token}}

### Get location by id
GET {{baseUrl}}/locations/{{locationId}}
Authorization: Bearer {{token}}

### Update location
PUT {{baseUrl}}/locations/{{locationId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "Updated Location Title"
}

### Delete location
DELETE {{baseUrl}}/locations/{{locationId}}
Authorization: Bearer {{token}}

############ MEMORIES ############

### Create text memory
POST {{baseUrl}}/locations/{{locationId}}/memories
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "content": "An amazing day at the Grand Canyon"
}

### Get memories for a location
GET {{baseUrl}}/locations/{{locationId}}/memories
Authorization: Bearer {{token}}

### Get memory by id
GET {{baseUrl}}/memories/{{memoryId}}
Authorization: Bearer {{token}}

### Update memory text
PUT {{baseUrl}}/memories/{{memoryId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "content": "Updated memory text"
}

### Upload images to a memory
### Place small sample images next to this file (or adjust the paths
### below) before running this request.
POST {{baseUrl}}/memories/{{memoryId}}/images
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=PathlyBoundary

--PathlyBoundary
Content-Disposition: form-data; name="images"; filename="sample-1.jpg"
Content-Type: image/jpeg

< ./sample-1.jpg
--PathlyBoundary
Content-Disposition: form-data; name="images"; filename="sample-2.jpg"
Content-Type: image/jpeg

< ./sample-2.jpg
--PathlyBoundary--

### Delete memory
DELETE {{baseUrl}}/memories/{{memoryId}}
Authorization: Bearer {{token}}

############ MISC ############

### Invalid route (expect 404)
GET {{baseUrl}}/not-existing
Authorization: Bearer {{token}}
